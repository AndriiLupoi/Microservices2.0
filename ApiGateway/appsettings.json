{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/catalog/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{**catch-all}"
          }
        ],
        "Metadata": {
          "Service": "Catalog",
          "Version": "v1",
          "Team": "Catalog Team"
        }
      },
      "orders-route": {
        "ClusterId": "orders-cluster",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{**catch-all}"
          }
        ],
        "Metadata": {
          "Service": "Orders",
          "Version": "v1"
        }
      },
      "reviews-route": {
        "ClusterId": "reviews-cluster",
        "Match": {
          "Path": "/api/reviews/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{**catch-all}"
          }
        ],
        "Metadata": {
          "Service": "Reviews",
          "Version": "v1"
        }
      },
      "aggregator-route": {
        "ClusterId": "aggregator-cluster",
        "Match": {
          "Path": "/api/aggregator/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{**catch-all}"
          }
        ],
        "Metadata": {
          "Service": "Aggregator",
          "Version": "v1",
          "Priority": "High"
        }
      }
    },
    "Clusters": {
      "catalog-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7001"
          }
        },
        "LoadBalancingPolicy": "RoundRobin",
        "HttpRequest": {
          "Timeout": "00:00:30"
        },
        "Metadata": {
          "MaxRequestBodySize": "10485760"
        }
      },
      "orders-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7002"
          }
        },
        "LoadBalancingPolicy": "RoundRobin",
        "HttpRequest": {
          "Timeout": "00:00:30"
        }
      },
      "reviews-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7003"
          }
        },
        "LoadBalancingPolicy": "RoundRobin",
        "HttpRequest": {
          "Timeout": "00:00:30"
        }
      },
      "aggregator-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7004"
          }
        },
        "HttpRequest": {
          "Timeout": "00:01:00"
        }
      }
    }
  }
}